# ---------------------------------------------------------------------------
# Configuracion del sistema de fichas de excepcion
# Copiar a .env.local y completar. .env.local NO se versiona.
# ---------------------------------------------------------------------------

# Firma de las cookies de sesion. OBLIGATORIO en produccion (min. 32 chars).
# Generar con:  openssl rand -base64 32
SESSION_SECRET=

# --- Capa de datos ---------------------------------------------------------
# sqlite   -> base local en archivo (desarrollo y servidor propio)
# supabase -> base Postgres de un proyecto Supabase (necesita SUPABASE_DB_URL)
DATA_ADAPTER=sqlite
SQLITE_PATH=./data/crm-excepciones.db

# --- Storage de adjuntos ---------------------------------------------------
# local    -> disco del servidor, fuera de /public
# supabase -> bucket privado de Supabase Storage (necesita las vars de abajo)
STORAGE_ADAPTER=local
STORAGE_PATH=./storage/adjuntos

# Tamano maximo del PDF adjunto, en MB.
MAX_PDF_MB=10

# Zona horaria para fechas y horarios mostrados.
TZ=America/Argentina/Buenos_Aires

# --- Supabase ----------------------------------------------------------
# Se completan solo si DATA_ADAPTER=supabase y/o STORAGE_ADAPTER=supabase.
# Los 3 valores estan en el proyecto de Supabase: guia paso a paso en
# docs/supabase.md.

# Project Settings -> Database -> Connection string (modo "URI", con el
# password real reemplazando [YOUR-PASSWORD]).
# SUPABASE_DB_URL=

# Project Settings -> API -> Project URL
# SUPABASE_URL=

# Project Settings -> API -> service_role (secreta: nunca la compartas ni la
# uses en el navegador).
# SUPABASE_SERVICE_ROLE_KEY=

# Nombre del bucket de Storage. Coincide con el que crea la migracion, asi
# que normalmente no hace falta tocarlo.
# SUPABASE_STORAGE_BUCKET=adjuntos-fichas

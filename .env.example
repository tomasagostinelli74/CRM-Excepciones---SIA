# ---------------------------------------------------------------------------
# Configuracion del sistema de fichas de excepcion
# Copiar a .env.local y completar. .env.local NO se versiona.
# ---------------------------------------------------------------------------

# Firma de las cookies de sesion. OBLIGATORIO en produccion (min. 32 chars).
# Generar con:  openssl rand -base64 32
SESSION_SECRET=

# --- Capa de datos ---------------------------------------------------------
# sqlite   -> base local en archivo (desarrollo y servidor propio)
# supabase -> pendiente de implementar (ver src/lib/data/supabase/index.ts)
DATA_ADAPTER=sqlite
SQLITE_PATH=./data/crm-excepciones.db

# --- Storage de adjuntos ---------------------------------------------------
# local    -> disco del servidor, fuera de /public
# supabase -> pendiente: bucket privado + signed URLs de vida corta
STORAGE_ADAPTER=local
STORAGE_PATH=./storage/adjuntos

# Tamano maximo del PDF adjunto, en MB.
MAX_PDF_MB=10

# Zona horaria para fechas y horarios mostrados.
TZ=America/Argentina/Buenos_Aires

# --- Supabase (EN STAND BY: sin uso hasta implementar el adaptador) --------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=adjuntos-fichas
